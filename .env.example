# Kotak Neo API credentials (see Neo app/website > Invest > Trade API)
KOTAK_CONSUMER_KEY=
KOTAK_ENVIRONMENT=prod

# Login identity
KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
KOTAK_UCC=
KOTAK_MPIN=

# TOTP secret (the same secret/QR used to set up your authenticator app,
# NOT a 6-digit code -- the bot generates fresh codes from this each run).
KOTAK_TOTP_SECRET=

# Trading mode switch. Keep "false" until you have validated a full dry-run
# session's logged signals against your own chart.
LIVE_TRADING=false

# Risk controls -- placeholders, set real values before LIVE_TRADING=true
LOT_SIZE=1
# Max cumulative rupee loss per day before the bot stops taking new entries.
# Leave blank/unset to disable the cap.
MAX_DAILY_LOSS=

# Profit target. The strategy is written as "30 points of the underlying",
# which at an ATM delta of ~0.5 is roughly 15 points of option premium.
# Whichever target is hit first squares the position off; leave either blank
# to disable that half of the check.
TARGET_UNDERLYING_POINTS=30
TARGET_PREMIUM_POINTS=15

LOG_LEVEL=INFO
